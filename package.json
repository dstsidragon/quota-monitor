{
  "name": "quota-monitor",
  "productName": "額度監控器",
  "version": "0.7.1",
  "description": "顯示 Claude Code 與 Codex 剩餘額度、reset 時間與相關公告的桌面小工具",
  "main": "src/boot.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.quota-monitor",
    "productName": "額度監控器",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/icon-256.png",
      "artifactName": "QuotaMonitor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "QuotaMonitor-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dstsidragon",
        "repo": "quota-monitor",
        "releaseType": "draft"
      }
    ]
  },
  "repository": "https://github.com/dstsidragon/quota-monitor"
}
